# Copy to .env (gitignored). Never commit real values.
# Keys are NOT configured here: they live in ~/.rescueroom/keys (chmod 600).

# NEAR testnet RPC (default: FastNEAR public testnet)
NEAR_RPC_URL=https://test.rpc.fastnear.com
# Sepolia RPC used by the relayer and dashboard
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Watcher: optional LLM explainer (NEAR AI Cloud, OpenAI-compatible). Score stays rule-based.
NEAR_AI_API_KEY=
NEAR_AI_MODEL=deepseek/deepseek-v3.2
# Usual working hours for the off-rhythm signal (UTC)
USUAL_FROM_UTC=7
USUAL_TO_UTC=19

# Alerts
APP_URL=http://127.0.0.1:5173
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=
# Sign webhook bodies: X-RescueRoom-Signature = sha256=HMAC(secret, "<X-RescueRoom-Timestamp>.<body>")
ALERT_WEBHOOK_SECRET=
# Email over any SMTP server, e.g. smtps://user:pass@smtp.example.com:465
SMTP_URL=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=Rescue Room <alerts@example.com>
# Only alert on events newer than this on first start (ms)
ALERT_BACKFILL_MS=600000

# Local API (indexer, alerts, attacker sandbox). Binds to localhost by default.
PORT=8787
HOST=127.0.0.1
# Behind a reverse proxy: trust X-Forwarded-For for per-client rate limits
TRUST_PROXY=0
SANDBOX_PER_CLIENT=2
SANDBOX_WINDOW_MIN=10
SANDBOX_PER_DAY=40
# Event source (free, no key)
FASTNEAR_TX_API=https://tx.test.fastnear.com
# Deliver alerts for the public sandbox vault too (off: they are logged only)
ALERT_SANDBOX=0
